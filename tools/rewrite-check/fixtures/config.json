{
  "platforms": {
    "weibo": {
      "enabled": true,
      "maxItems": 50
    },
    "douyin": {
      "enabled": true,
      "maxItems": 50
    },
    "tieba": {
      "enabled": true,
      "maxItems": 50,
      "hotTopicUrl": "https://tieba.baidu.com/hottopic/browse/topicList?res_type=1"
    },
    "hupu": {
      "enabled": true,
      "maxItems": 80,
      "boards": [
        {
          "board": "步行街",
          "url": "https://bbs.hupu.com/all-gambia",
          "maxItems": 25
        },
        {
          "board": "英雄联盟",
          "url": "https://bbs.hupu.com/lol",
          "maxItems": 25
        },
        {
          "board": "NBA",
          "url": "https://bbs.hupu.com/nba",
          "maxItems": 25
        },
        {
          "board": "国际足球",
          "url": "https://bbs.hupu.com/soccer",
          "maxItems": 25
        }
      ]
    }
  },
  "filters": {
    "allowedCategories": ["游戏", "电竞", "体育", "AI"],
    "minTitleLength": 4
  },
  "cluster": {
    "similarityThreshold": 0.42
  },
  "eventMerge": {
    "enabled": true,
    "candidateLimit": 36,
    "preSummaryCandidateLimit": 12,
    "preSummaryRetrievalLimit": 4,
    "preSummaryTimeBudgetSeconds": 90,
    "maxMergeBatchSize": 8,
    "minConfidence": 0.8
  },
  "eventSummary": {
    "enabled": true,
    "cacheTtlHours": 6,
    "retrievalLimit": 10,
    "concurrency": 2,
    "timeBudgetSeconds": 180,
    "failureCacheTtlMinutes": 30,
    "weiboWisEnabled": true,
    "weiboWisQueryLimit": 3
  },
  "eventFilter": {
    "enabled": true,
    "minConfidence": 0.75
  },
  "snapshot": {
    "maxAgeMinutes": 20,
    "trendWindowMinutes": 70
  },
  "retrieval": {
    "health": {
      "confirmationDelayMinutes": 30,
      "firstOpenHours": 48,
      "repeatOpenHours": 96,
      "recoverySuccessesRequired": 2
    },
    "capabilities": [
      "openclaw.agent.sibyl-retriever",
      "browser.search",
      "web_fetch.read"
    ]
  },
  "alerts": {
    "enabled": true,
    "pushWeCom": false,
    "webhook": "",
    "dedupe": "daily",
    "summaries": true,
    "douyinTopic": {
      "enabled": true,
      "directPageEnabled": false,
      "relatedTopicLimit": 8,
      "timeout": 12000,
      "retries": 0
    },
    "agentReachSummary": {
      "enabled": true,
      "command": "openclaw",
      "agent": "sibyl-retriever",
      "sessionFlag": "none",
      "retryDelayMs": 1000,
      "timeoutSeconds": 90,
      "thinking": "low",
      "minSources": 2,
      "minConfidence": "medium",
      "maxSources": 4,
      "maxAgeHours": 96,
      "maxEvidenceChars": 6000,
      "allowTrustedSingleSource": true,
      "trustedDomains": [
        "cctv.com",
        "xinhuanet.com",
        "news.cn",
        "fifa.com",
        "uefa.com",
        "the-afc.com",
        "olympics.com",
        "nba.com"
      ],
      "capabilities": [
        "browser.search"
      ]
    },
    "aiSearchSummary": {
      "enabled": false,
      "maxChars": 110
    },
    "weiboAI": {
      "appId": "",
      "appSecret": "",
      "authUrl": "https://open-im.api.weibo.com/open/auth/ws_token",
      "searchUrl": "https://open-im.api.weibo.com/open/wis/search_query"
    },
    "platforms": {
      "weibo": {
        "enabled": true,
        "rankMax": 10,
        "hotMin": 500000
      },
      "douyin": {
        "enabled": true,
        "rankMax": 10,
        "hotMin": 8000000
      }
    }
  },
  "report": {
    "topN": 10,
    "minScore": 20,
    "requireSeedPlatforms": true,
    "seedPlatforms": ["weibo", "douyin"],
    "pushWeCom": false,
    "webhook": ""
  }
}
